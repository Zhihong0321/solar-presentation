# Copy to .env.local and fill in.

# Direct Postgres connection.
# On Railway: set DATABASE_URL as a reference to your Postgres service, e.g.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}   (internal, no TLS)
# For local testing you need a reachable (public) connection string.
DATABASE_URL=postgresql://user:pass@host:5432/prod_main

# Set to "false" only if connecting to a non-TLS public host that the
# internal-host heuristic doesn't catch. Leave unset otherwise.
# PGSSL=false

# Set to "true" to only load invoices whose share link is explicitly enabled.
# Default false: the sales agent drives the deck, so drafts should load.
REQUIRE_SHARE_ENABLED=false
