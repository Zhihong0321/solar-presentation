  timers = []; rafs = {}; audioEls = null; scrollEl = null; scrollPending = false;

  SEQ = [['s0'], ['s1'], ['s2'], ['s3'], ['s4a', 's4b'], ['s5a', 's5b', 's5c'], ['s6'], ['s7']];
