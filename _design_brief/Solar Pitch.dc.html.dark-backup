  FINAL = { 1: { bill: 380, nb: 95, pct: 75 }, 2: { gen: 860, nb2: 95 }, 3: { kwp: 8.45 }, 4: { loss: 12000 }, 6: { proj: 140 }, 7: { price: 24200 } };
  BEATS = {
