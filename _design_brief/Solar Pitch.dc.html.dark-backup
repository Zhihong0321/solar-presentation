<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Noto+Serif+SC:wght@600;700&display=swap" rel="stylesheet">
<style>
html,body{margin:0;padding:0;background:#08080D;overscroll-behavior:none}
a{color:#F2B23E}a:hover{color:#FFCE6B}
#deck::-webkit-scrollbar{display:none}
@keyframes glowPulse{0%,100%{opacity:.45;transform:scale(1)}50%{opacity:.85;transform:scale(1.18)}}
@keyframes tapRing{0%{transform:scale(.85);opacity:.9}75%{transform:scale(1.6);opacity:0}100%{opacity:0}}
@keyframes dropflow{0%{transform:translateY(-8px);opacity:0}18%{opacity:1}82%{opacity:1}100%{transform:translateY(58px);opacity:0}}
@keyframes ctaPulse{0%,100%{box-shadow:0 0 0 0 rgba(242,178,62,.5)}50%{box-shadow:0 0 26px 8px rgba(242,178,62,.22)}}
@keyframes kenburns{from{transform:scale(1.06) translate(0,0)}to{transform:scale(1.2) translate(-3%,-2%)}}
@keyframes floatOrb{0%,100%{transform:translate(0,0)}50%{transform:translate(14px,-20px)}}
@keyframes breathe{0%,100%{opacity:.45;transform:scale(1)}50%{opacity:1;transform:scale(1.06)}}
@keyframes nudge{0%,100%{transform:translateY(0);opacity:.55}50%{transform:translateY(9px);opacity:1}}
</style>
</helmet>
<div id="deck" ref="{{ setScroll }}" onScroll="{{ onScroll }}" style="height:100dvh;overflow-y:auto;overflow-x:hidden;scroll-snap-type:y mandatory;background:#08080D;color:#F4F1EA;font-family:'Space Grotesk',system-ui,sans-serif;scrollbar-width:none;position:relative">

  <section data-screen-label="0 Cover" onClick="{{ begin }}" style="height:100dvh;scroll-snap-align:start;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px;box-sizing:border-box;cursor:pointer">
    <div style="position:absolute;top:-15%;left:50%;margin-left:-160px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(242,178,62,.28) 0%,rgba(242,178,62,0) 70%);animation:glowPulse 6s ease-in-out infinite"></div>
    <div style="position:absolute;bottom:8%;right:-60px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(242,178,62,.12) 0%,rgba(242,178,62,0) 70%);animation:floatOrb 9s ease-in-out infinite"></div>
    <div style="display:flex;flex-direction:column;align-items:center;gap:26px;text-align:center;position:relative">
      <img src="assets/logo-02.png" alt="Eternalgy" style="width:210px;transition:opacity 1.2s ease,transform 1.2s ease;{{ r.s0logo }}">
      <h1 style="margin:0;font-size:clamp(30px,8.5vw,38px);line-height:1.18;font-weight:700;letter-spacing:-.01em;white-space:pre-line;transition:opacity .9s ease,transform .9s ease;{{ r.s0title }}">{{ t.s0h1 }}</h1>
      <p style="margin:0;font-size:17px;line-height:1.5;color:#B8B2A4;max-width:300px;transition:opacity .9s ease,transform .9s ease;{{ r.s0thesis }}">{{ t.s0thesisPre }}<span style="color:#F2B23E;font-weight:600">{{ t.s0thesisEm }}</span></p>
    </div>
    <div style="position:absolute;bottom:64px;left:0;right:0;display:flex;flex-direction:column;align-items:center;gap:14px;transition:opacity .6s ease;opacity:{{ tapOp }};pointer-events:none">
      <div style="position:relative;width:58px;height:58px;display:flex;align-items:center;justify-content:center">
        <div style="position:absolute;inset:0;border-radius:50%;border:1.5px solid rgba(242,178,62,.7);animation:tapRing 2.2s ease-out infinite"></div>
        <div style="width:14px;height:14px;border-radius:50%;background:#F2B23E"></div>
      </div>
      <div style="font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:#F2B23E">{{ t.tap }}</div>
    </div>
  </section>

  <section data-screen-label="1 Your Bill" style="height:100dvh;scroll-snap-align:start;display:flex;flex-direction:column;justify-content:center;gap:18px;padding:32px 26px;box-sizing:border-box;position:relative;overflow:hidden">
    <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#F2B23E;opacity:.9">{{ t.s1eyebrow }}</div>
    <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:18px;padding:20px 22px;transition:opacity .7s cubic-bezier(.22,.7,.25,1),transform .7s cubic-bezier(.22,.7,.25,1);{{ r.s1cur }}">
      <div style="font-size:13px;color:#8F8A7E;margin-bottom:6px">{{ t.s1curLabel }}</div>
      <div style="font-size:52px;font-weight:700;letter-spacing:-.02em;line-height:1;color:#DCD6C8">RM {{ c.bill }}<span style="font-size:16px;font-weight:500;color:#8F8A7E">{{ t.perMo }}</span></div>
    </div>
    <div style="align-self:center;color:#F2B23E;font-size:26px;line-height:1;transition:opacity .5s ease,transform .5s ease;{{ r.s1arrow }}">↓</div>
    <div style="background:linear-gradient(160deg,rgba(242,178,62,.14),rgba(242,178,62,.04));border:1px solid rgba(242,178,62,.45);border-radius:18px;padding:20px 22px;position:relative;box-shadow:0 8px 40px rgba(242,178,62,.1);transition:opacity .7s cubic-bezier(.22,.7,.25,1),transform .7s cubic-bezier(.22,.7,.25,1);{{ r.s1new }}">
      <div style="font-size:13px;color:#E8C685;margin-bottom:6px">{{ t.s1withLabel }}</div>
      <div style="font-size:60px;font-weight:700;letter-spacing:-.02em;line-height:1;color:#FFCE6B">RM {{ c.nb }}<span style="font-size:16px;font-weight:500;color:#C9A25C">{{ t.perMo }}</span></div>
      <div style="position:absolute;top:-18px;right:16px;background:#F2B23E;color:#171207;font-weight:700;font-size:17px;padding:10px 14px;border-radius:99px;box-shadow:0 6px 24px rgba(242,178,62,.45);transition:opacity .45s cubic-bezier(.34,1.56,.64,1),transform .45s cubic-bezier(.34,1.56,.64,1);{{ r.s1badge }}">−{{ c.pct }}%</div>
    </div>
    <p style="margin:6px 0 0;font-size:16px;line-height:1.5;color:#B8B2A4;transition:opacity .8s ease,transform .8s ease;{{ r.s1tail }}">{{ t.s1tailPre }}<span style="color:#F4F1EA;font-weight:600">{{ t.s1tailEm }}</span></p>
  </section>

  <section data-screen-label="2 How We Calculated" style="height:100dvh;scroll-snap-align:start;display:flex;flex-direction:column;justify-content:center;gap:10px;padding:28px 26px;box-sizing:border-box;overflow:hidden">
    <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#F2B23E;margin-bottom:6px">{{ t.s2eyebrow }}</div>
    <div style="align-self:center;text-align:center;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:14px 26px;transition:opacity .7s ease,transform .7s ease;{{ r.s2gen }}">
      <div style="font-size:40px;font-weight:700;line-height:1;letter-spacing:-.02em">{{ c.gen }} <span style="font-size:15px;font-weight:500;color:#8F8A7E">{{ t.kwhMo }}</span></div>
      <div style="font-size:12px;color:#8F8A7E;margin-top:4px">{{ t.s2genLabel }}</div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:2px">
      <div style="display:flex;flex-direction:column;align-items:center;gap:0">
        <div style="height:54px;width:2px;background:rgba(242,178,62,.18);position:relative;overflow:visible;opacity:{{ flowOp }};transition:opacity .6s ease">
          <div style="position:absolute;left:-2px;top:0;width:6px;height:6px;border-radius:50%;background:#F2B23E;animation:dropflow 1.5s linear infinite"></div>
          <div style="position:absolute;left:-2px;top:0;width:6px;height:6px;border-radius:50%;background:#F2B23E;animation:dropflow 1.5s linear .75s infinite"></div>
        </div>
        <div style="width:100%;box-sizing:border-box;text-align:center;background:rgba(242,178,62,.08);border:1px solid rgba(242,178,62,.3);border-radius:14px;padding:12px 10px;transition:opacity .7s ease,transform .7s ease;{{ r.s2left }}">
          <div style="font-size:26px;font-weight:700;color:#FFCE6B;line-height:1">40%</div>
          <div style="font-size:12px;color:#B8B2A4;margin-top:4px;line-height:1.35">{{ t.s2leftLabel }}</div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:0">
        <div style="height:54px;width:2px;background:rgba(242,178,62,.18);position:relative;opacity:{{ flowOp }};transition:opacity .6s ease">
          <div style="position:absolute;left:-2px;top:0;width:6px;height:6px;border-radius:50%;background:#F2B23E;animation:dropflow 1.5s linear .4s infinite"></div>
          <div style="position:absolute;left:-2px;top:0;width:6px;height:6px;border-radius:50%;background:#F2B23E;animation:dropflow 1.5s linear 1.15s infinite"></div>
        </div>
        <div style="width:100%;box-sizing:border-box;text-align:center;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:12px 10px;transition:opacity .7s ease,transform .7s ease;{{ r.s2right }}">
          <div style="font-size:26px;font-weight:700;line-height:1">60%</div>
          <div style="font-size:12px;color:#B8B2A4;margin-top:4px;line-height:1.35">{{ t.s2rightLabel }}</div>
        </div>
      </div>
    </div>
    <div style="align-self:center;color:#F2B23E;font-size:20px;line-height:1;opacity:{{ flowOp }};transition:opacity .6s ease">↓ ↓</div>
    <div style="align-self:center;text-align:center;background:linear-gradient(160deg,rgba(242,178,62,.16),rgba(242,178,62,.05));border:1px solid rgba(242,178,62,.5);border-radius:16px;padding:14px 30px;box-shadow:0 8px 36px rgba(242,178,62,.12);transition:opacity .7s ease,transform .7s ease;{{ r.s2conv }}">
      <div style="font-size:12px;color:#E8C685">{{ t.s2newBillLabel }}</div>
      <div style="font-size:44px;font-weight:700;line-height:1.05;color:#FFCE6B;letter-spacing:-.02em">RM {{ c.nb2 }}<span style="font-size:14px;color:#C9A25C;font-weight:500">{{ t.perMo }}</span></div>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px;margin-top:8px;align-items:center">
      <div style="font-size:12.5px;color:#B8B2A4;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:99px;padding:7px 14px;transition:opacity .6s ease,transform .6s ease;{{ r.s2chip }}">{{ t.s2chip }}</div>
      <div style="font-size:12px;color:#8F8A7E;text-align:center;line-height:1.5;max-width:300px;transition:opacity .8s ease,transform .8s ease;{{ r.s2tag }}">{{ t.s2tagPre }}<span style="color:#F2B23E">{{ t.s2tagEm }}</span>{{ t.s2tagPost }}</div>
    </div>
  </section>

  <section data-screen-label="3 Your Package" style="height:100dvh;scroll-snap-align:start;display:flex;flex-direction:column;justify-content:center;gap:16px;padding:32px 26px;box-sizing:border-box;overflow:hidden">
    <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#F2B23E">{{ t.s3eyebrow }}</div>
    <div style="transition:opacity .7s ease,transform .7s ease;{{ r.s3kwp }}">
      <div style="font-size:74px;font-weight:700;line-height:1;letter-spacing:-.03em">{{ c.kwp }}<span style="font-size:22px;font-weight:500;color:#8F8A7E">{{ t.kwpUnit }}</span></div>
      <div style="font-size:14px;color:#8F8A7E;margin-top:6px">{{ t.s3sizedLabel }}</div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:16px;padding:16px;transition:opacity .7s ease,transform .7s ease;{{ r.s3panel }}">
      <div style="background:#fff;border-radius:10px;padding:6px 8px;flex:0 0 auto;display:flex;align-items:center"><img src="assets/jinko-logo.svg" alt="JinkoSolar" style="height:20px;display:block"></div>
      <div style="min-width:0">
        <div style="font-size:15px;font-weight:600;line-height:1.3;white-space:pre-line">{{ t.s3panelName }}</div>
        <div style="display:inline-block;margin-top:6px;font-size:10.5px;letter-spacing:.04em;color:#E8C685;border:1px solid rgba(242,178,62,.4);border-radius:99px;padding:3px 9px;transition:opacity .5s cubic-bezier(.34,1.56,.64,1),transform .5s cubic-bezier(.34,1.56,.64,1);{{ r.s3badge }}">{{ t.s3badge }}</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:16px;padding:16px;transition:opacity .7s ease,transform .7s ease;{{ r.s3inv }}">
      <div style="background:#fff;border-radius:10px;padding:6px 8px;flex:0 0 auto;display:flex;align-items:center"><img src="assets/saj-logo.jpg" alt="SAJ" style="height:20px;display:block"></div>
      <div style="font-size:15px;font-weight:600">{{ t.s3invName }}</div>
    </div>
    <div style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;color:#8F8A7E;background:rgba(255,255,255,.03);border:1px dashed rgba(255,255,255,.14);border-radius:12px;padding:12px 16px;text-align:center;transition:opacity .7s ease,transform .7s ease;{{ r.s3formula }}">13 × 650W ÷ 1000 = <span style="color:#F2B23E">8.45 kWp</span></div>
  </section>

  <section data-screen-label="4 Forecast You Can Trust" style="height:100dvh;scroll-snap-align:start;display:flex;flex-direction:column;justify-content:center;gap:14px;padding:30px 26px;box-sizing:border-box;overflow:hidden">
    <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#F2B23E">{{ t.s4eyebrow }}</div>
    <div style="font-size:14px;color:#8F8A7E;transition:opacity .7s ease,transform .7s ease;{{ r.s4warn }}">{{ t.s4warn }}</div>
    <h2 style="margin:0;font-size:27px;line-height:1.25;font-weight:700;letter-spacing:-.01em;transition:opacity .7s ease,transform .7s ease;{{ r.s4trick }}">{{ t.s4trickPre }}<span style="color:#FF7A5C">{{ t.s4trickEm }}</span></h2>
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <div style="background:rgba(255,122,92,.1);border:1px solid rgba(255,122,92,.35);border-radius:12px;padding:9px 13px;font-size:15px;font-weight:600;color:#FFB4A1;transition:opacity .45s cubic-bezier(.34,1.56,.64,1),transform .45s cubic-bezier(.34,1.56,.64,1);{{ r.s4rm50 }}">{{ t.rm50 }}</div>
      <div style="font-size:15px;font-weight:600;color:#8F8A7E;transition:opacity .4s cubic-bezier(.34,1.56,.64,1),transform .4s cubic-bezier(.34,1.56,.64,1);{{ r.s4x12 }}">× 12</div>
      <div style="font-size:15px;font-weight:600;color:#8F8A7E;transition:opacity .4s cubic-bezier(.34,1.56,.64,1),transform .4s cubic-bezier(.34,1.56,.64,1);{{ r.s4x20 }}">{{ t.x20 }}</div>
    </div>
    <div style="transition:opacity .6s ease,transform .6s ease;{{ r.s4x20 }}">
      <div style="font-size:56px;font-weight:700;line-height:1;letter-spacing:-.02em;color:#FF7A5C">− RM {{ c.loss }}</div>
      <div style="font-size:13px;color:#8F8A7E;margin-top:6px">{{ t.s4lossLabel }}</div>
    </div>
    <div style="font-size:17px;font-weight:600;color:#F4F1EA;transition:opacity .8s ease,transform .8s ease;{{ r.s4lies }}">{{ t.s4lies }}</div>
    <div style="height:1px;background:rgba(255,255,255,.08);margin:2px 0"></div>
    <div style="align-self:flex-start;background:linear-gradient(160deg,rgba(242,178,62,.18),rgba(242,178,62,.06));border:1px solid rgba(242,178,62,.5);border-radius:14px;padding:12px 18px;font-size:14px;font-weight:700;letter-spacing:.06em;color:#FFCE6B;box-shadow:0 8px 32px rgba(242,178,62,.12);transition:opacity .5s cubic-bezier(.34,1.56,.64,1),transform .5s cubic-bezier(.34,1.56,.64,1);{{ r.s4badge }}">{{ t.s4badge }}</div>
    <div style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:#B8B2A4;transition:opacity .6s ease,transform .6s ease;{{ r.s4flash }}"><span style="color:#F2B23E">{{ t.s4flashA }}</span>{{ t.s4flashMid }}<span style="color:#F2B23E">{{ t.s4flashB }}</span><span style="color:#8F8A7E">{{ t.s4flashTail }}</span></div>
    <div style="font-size:17px;color:#F4F1EA;transition:opacity .8s ease,transform .8s ease;{{ r.s4notest }}">{{ t.s4notestPre }}<span style="color:#F2B23E;font-weight:700">{{ t.s4notestEm }}</span></div>
  </section>

  <section data-screen-label="5 Built to Survive" style="height:100dvh;scroll-snap-align:start;position:relative;overflow:hidden;background:#050507">
    <video src="assets/jinko-degradation.mp4" autoPlay="{{ true }}" muted="{{ true }}" loop="{{ true }}" playsInline="{{ true }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.1;filter:saturate(.3)"></video>
    <div style="position:absolute;inset:0;background:#000;opacity:{{ dimOp }};transition:opacity 1.2s ease;pointer-events:none"></div>
    <div style="position:absolute;top:30px;left:26px;font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#F2B23E">{{ t.s5eyebrow }}</div>
    <div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;gap:22px;padding:32px 28px;box-sizing:border-box;opacity:{{ qBlockOp }};transition:opacity 1s ease;pointer-events:none">
      <p style="margin:0;font-size:22px;line-height:1.45;color:#B8B2A4;transition:opacity .9s ease,transform .9s ease;{{ r.s5l1 }}">{{ t.s5l1Pre }}<span style="color:#F4F1EA;font-weight:600">{{ t.s5l1Em }}</span>{{ t.s5l1Mid }}<br>{{ t.s5l1Tail }}</p>
      <p style="margin:0;font-size:22px;line-height:1.45;color:#B8B2A4;transition:opacity .9s ease,transform .9s ease;{{ r.s5l2 }}">{{ t.s5l2Pre }}<span style="color:#F4F1EA;font-weight:600">{{ t.s5l2Em }}</span>{{ t.s5l2Mid }}<br>{{ t.s5l2Tail }}</p>
      <p style="margin:0;font-size:28px;line-height:1.4;font-weight:700;color:#FFCE6B;transition:opacity 1.1s ease,transform 1.1s ease;{{ r.s5q }}">{{ t.s5qLine1 }}<br>{{ t.s5qLine2 }}</p>
    </div>
    <div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;gap:20px;padding:32px 28px;box-sizing:border-box;opacity:{{ yearsOp }};transition:opacity 1s ease;pointer-events:none">
      <div style="transition:opacity .9s ease,transform .9s ease;{{ r.s5years }}">
        <div style="font-size:15px;color:#8F8A7E;margin-bottom:8px">{{ t.s5yearsLabel }}</div>
        <div style="font-size:64px;font-weight:700;line-height:1;letter-spacing:-.02em">15–20<span style="font-size:26px;font-weight:600;color:#F2B23E">{{ t.s5yearsUnit }}</span></div>
      </div>
      <p style="margin:0;font-size:19px;line-height:1.5;color:#B8B2A4;transition:opacity .9s ease,transform .9s ease;{{ r.s5fail }}">{{ t.s5failLine1 }}<br>{{ t.s5failLine2 }}<br>{{ t.s5failLine3 }}</p>
      <div style="font-size:34px;font-weight:600;color:#F4F1EA;opacity:{{ fireOp }};transition:opacity 1.4s ease">{{ t.s5fire }}</div>
    </div>
    <div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;gap:24px;padding:32px 28px;box-sizing:border-box;text-align:center;opacity:{{ provOp }};transition:opacity 1.2s ease;pointer-events:none">
      <div style="font-family:'Noto Serif SC',serif;font-size:31px;line-height:1.75;font-weight:700;color:#FFCE6B;transition:opacity 1.2s ease,transform 1.2s ease;{{ r.s5prov }}">真正的划算是诚信，<br>真正的昂贵是风险。</div>
      <div style="font-size:15px;line-height:1.6;color:#B8B2A4;font-style:italic;transition:opacity 1s ease,transform 1s ease;{{ r.s5sub }}">{{ t.s5subLine1 }}<br>{{ t.s5subLine2 }}</div>
    </div>
  </section>

  <section data-screen-label="6 We Don't Disappear" style="height:100dvh;scroll-snap-align:start;display:flex;flex-direction:column;justify-content:center;gap:12px;padding:28px 26px;box-sizing:border-box;overflow:hidden">
    <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#F2B23E">{{ t.s6eyebrow }}</div>
    <h2 style="margin:0;font-size:26px;line-height:1.25;font-weight:700;letter-spacing:-.01em;transition:opacity .7s ease,transform .7s ease;{{ r.s6msg }}">{{ t.s6h2Line1 }}<br>{{ t.s6h2Line2 }}</h2>
    <div style="display:flex;align-items:center;gap:14px;transition:opacity .7s ease,transform .7s ease;{{ r.s6img }}">
      <img src="assets/roof-specialist.webp" alt="In-house roof team" style="width:96px;height:68px;object-fit:cover;border-radius:12px;border:1px solid rgba(255,255,255,.1);flex:0 0 auto">
      <div style="font-size:13.5px;line-height:1.45;color:#B8B2A4">{{ t.s6teamPre }}<span style="color:#F4F1EA;font-weight:600">{{ t.s6teamEm }}</span>{{ t.s6teamPost }}</div>
    </div>
    <div style="display:flex;align-items:baseline;gap:10px;transition:opacity .7s ease,transform .7s ease;{{ r.s6stat }}">
      <div style="font-size:54px;font-weight:700;line-height:1;letter-spacing:-.02em;color:#FFCE6B">{{ c.proj }}</div>
      <div style="font-size:14px;color:#8F8A7E;line-height:1.3">{{ t.s6projLabel1 }}<br>{{ t.s6projLabel2 }}</div>
    </div>
    <div style="position:relative;border-radius:14px;overflow:hidden;border:1px solid rgba(255,255,255,.09)">
      <img src="assets/all-roof-type.webp" alt="Every roof type" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.22">
      <div style="position:relative;display:flex;flex-wrap:wrap;gap:7px;padding:13px">
        <div style="font-size:12px;font-weight:600;background:rgba(8,8,13,.75);border:1px solid rgba(242,178,62,.35);color:#E8C685;border-radius:99px;padding:5px 12px;transition:opacity .4s cubic-bezier(.34,1.56,.64,1),transform .4s cubic-bezier(.34,1.56,.64,1);{{ r.s6r1 }}">{{ t.terraceTag }}</div>
        <div style="font-size:12px;font-weight:600;background:rgba(8,8,13,.75);border:1px solid rgba(242,178,62,.35);color:#E8C685;border-radius:99px;padding:5px 12px;transition:opacity .4s cubic-bezier(.34,1.56,.64,1),transform .4s cubic-bezier(.34,1.56,.64,1);{{ r.s6r2 }}">{{ t.bungalowTag }}</div>
        <div style="font-size:12px;font-weight:600;background:rgba(8,8,13,.75);border:1px solid rgba(242,178,62,.35);color:#E8C685;border-radius:99px;padding:5px 12px;transition:opacity .4s cubic-bezier(.34,1.56,.64,1),transform .4s cubic-bezier(.34,1.56,.64,1);{{ r.s6r3 }}">{{ t.farmTag }}</div>
        <div style="font-size:12px;font-weight:600;background:rgba(8,8,13,.75);border:1px solid rgba(242,178,62,.35);color:#E8C685;border-radius:99px;padding:5px 12px;transition:opacity .4s cubic-bezier(.34,1.56,.64,1),transform .4s cubic-bezier(.34,1.56,.64,1);{{ r.s6r4 }}">{{ t.industrialTag }}</div>
        <div style="width:100%;font-size:11.5px;color:#B8B2A4">{{ t.s6everyRoof }}</div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px">
      <div style="background:#fff;border-radius:10px;padding:7px;display:flex;align-items:center;justify-content:center;height:34px;transition:opacity .45s cubic-bezier(.34,1.56,.64,1),transform .45s cubic-bezier(.34,1.56,.64,1);{{ r.s6c1 }}"><img src="assets/seda.png" alt="SEDA" style="max-width:100%;max-height:100%;object-fit:contain"></div>
      <div style="background:#fff;border-radius:10px;padding:7px;display:flex;align-items:center;justify-content:center;height:34px;transition:opacity .45s cubic-bezier(.34,1.56,.64,1),transform .45s cubic-bezier(.34,1.56,.64,1);{{ r.s6c2 }}"><img src="assets/cidb.png" alt="CIDB" style="max-width:100%;max-height:100%;object-fit:contain"></div>
      <div style="background:#fff;border-radius:10px;padding:7px;display:flex;align-items:center;justify-content:center;height:34px;transition:opacity .45s cubic-bezier(.34,1.56,.64,1),transform .45s cubic-bezier(.34,1.56,.64,1);{{ r.s6c3 }}"><img src="assets/myhijau.jpg" alt="MyHIJAU" style="max-width:100%;max-height:100%;object-fit:contain"></div>
      <div style="background:#fff;border-radius:10px;padding:7px;display:flex;align-items:center;justify-content:center;height:34px;transition:opacity .45s cubic-bezier(.34,1.56,.64,1),transform .45s cubic-bezier(.34,1.56,.64,1);{{ r.s6c4 }}"><img src="assets/msig.png" alt="MSIG" style="max-width:100%;max-height:100%;object-fit:contain"></div>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:6px;transition:opacity .7s ease,transform .7s ease;{{ r.s6badges }}">
      <div style="font-size:10.5px;color:#8F8A7E;border:1px solid rgba(255,255,255,.12);border-radius:99px;padding:4px 10px">{{ t.s6badge1 }}</div>
      <div style="font-size:10.5px;color:#8F8A7E;border:1px solid rgba(255,255,255,.12);border-radius:99px;padding:4px 10px">{{ t.s6badge2 }}</div>
      <div style="font-size:10.5px;color:#8F8A7E;border:1px solid rgba(255,255,255,.12);border-radius:99px;padding:4px 10px">{{ t.s6badge3 }}</div>
    </div>
    <div style="border-radius:14px;overflow:hidden;height:130px;border:1px solid rgba(255,255,255,.1);transition:opacity 1s ease,transform 1s ease;{{ r.s6photo }}">
      <img src="assets/group-photo.jpg" alt="The Eternalgy team" style="width:100%;height:100%;object-fit:cover;animation:kenburns 14s ease-out forwards">
    </div>
  </section>

  <section data-screen-label="7 The Ask" style="height:100dvh;scroll-snap-align:start;display:flex;flex-direction:column;justify-content:center;gap:16px;padding:32px 26px;box-sizing:border-box;overflow:hidden;position:relative">
    <div style="position:absolute;top:-10%;right:-20%;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(242,178,62,.16) 0%,rgba(242,178,62,0) 70%);animation:glowPulse 7s ease-in-out infinite"></div>
    <div style="font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:#F2B23E">{{ t.s7eyebrow }}</div>
    <div style="font-size:15px;color:#B8B2A4;transition:opacity .7s ease,transform .7s ease;{{ r.s7lead }}">{{ t.s7lead }}</div>
    <div style="background:linear-gradient(160deg,rgba(242,178,62,.14),rgba(242,178,62,.04));border:1px solid rgba(242,178,62,.45);border-radius:18px;padding:22px;box-shadow:0 8px 40px rgba(242,178,62,.1);transition:opacity .7s ease,transform .7s ease;{{ r.s7price }}">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
        <span style="font-size:16px;color:#8F8A7E;text-decoration:line-through">RM 26,800</span>
        <span style="font-size:10.5px;font-weight:700;letter-spacing:.08em;background:#F2B23E;color:#171207;border-radius:99px;padding:3px 9px">{{ t.s7promo }}</span>
      </div>
      <div style="font-size:56px;font-weight:700;line-height:1;letter-spacing:-.02em;color:#FFCE6B">RM {{ c.price }}</div>
      <div style="font-size:13px;color:#E8C685;margin-top:6px">{{ t.s7afterDiscount }}</div>
    </div>
    <div style="display:flex;align-items:center;gap:12px;transition:opacity .7s ease,transform .7s ease;{{ r.s7pay }}">
      <div style="font-size:34px;font-weight:700;color:#F4F1EA;line-height:1">≈6<span style="font-size:16px;font-weight:600;color:#F2B23E">{{ t.s7yrsUnit }}</span></div>
      <div style="font-size:13.5px;color:#B8B2A4;line-height:1.4">{{ t.s7payPre }}<span style="color:#F4F1EA;font-weight:600">{{ t.s7payEm }}</span></div>
    </div>
    <div style="display:flex;flex-direction:column;gap:6px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.09);border-radius:14px;padding:14px 16px;font-size:12.5px;color:#B8B2A4;line-height:1.5;transition:opacity .7s ease,transform .7s ease;{{ r.s7warr }}">
      <div><span style="color:#F2B23E">{{ t.s7warrPanelLabel }}</span>{{ t.s7warrPanelText }}</div>
      <div><span style="color:#F2B23E">{{ t.s7warrInvLabel }}</span>{{ t.s7warrInvText }}</div>
      <div><span style="color:#F2B23E">{{ t.s7warrInstallLabel }}</span>{{ t.s7warrInstallText }}</div>
    </div>
    <div style="background:#F2B23E;color:#171207;font-size:17px;font-weight:700;text-align:center;border-radius:99px;padding:17px 20px;margin-top:4px;cursor:pointer;transition:opacity .7s ease,transform .7s ease;{{ r.s7cta }};{{ ctaAnim }}">{{ t.s7cta }}</div>
  </section>

  <img src="assets/logo-02.png" alt="Eternalgy" style="position:fixed;top:18px;left:50%;transform:translateX(-50%);width:104px;z-index:25;opacity:{{ logoOp }};transition:opacity .6s ease;pointer-events:none">

  <div style="position:fixed;bottom:26px;left:50%;transform:translateX(-50%);z-index:25;opacity:{{ presentOp }};transition:opacity .4s ease;pointer-events:none">
    <div style="display:flex;align-items:center;gap:8px;background:rgba(8,8,13,.55);border:1px solid rgba(242,178,62,.4);border-radius:99px;padding:6px 14px;backdrop-filter:blur(4px);animation:breathe 2.4s ease-in-out infinite">
      <span style="width:8px;height:8px;border-radius:50%;background:#F2B23E;box-shadow:0 0 8px rgba(242,178,62,.8)"></span>
      <span style="font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#F2B23E;font-weight:600">{{ t.presenting }}</span>
    </div>
  </div>

  <div style="position:fixed;left:0;right:0;bottom:28px;z-index:24;display:flex;flex-direction:column;align-items:center;gap:5px;opacity:{{ nextArrowOp }};transition:opacity .5s ease;pointer-events:none">
    <span style="font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#F2B23E;font-weight:600">{{ t.next }}</span>
    <div style="font-size:28px;line-height:1;color:#F2B23E;animation:nudge 1.4s ease-in-out infinite">↓</div>
  </div>

  <div style="position:fixed;right:12px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:8px;z-index:20;pointer-events:none">
    <sc-for list="{{ dots }}" as="d" hint-placeholder-count="8">
      <div style="{{ d.s }}"></div>
    </sc-for>
  </div>
  <sc-if value="{{ showCap }}" hint-placeholder-val="{{ false }}">
    <div style="position:fixed;left:16px;right:28px;bottom:14px;z-index:20;background:rgba(8,8,13,.85);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:10px 14px;font-size:11.5px;line-height:1.5;color:#B8B2A4;pointer-events:none">{{ capText }}</div>
  </sc-if>

  <div style="position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:40px;padding:32px;box-sizing:border-box;background:#08080D;opacity:{{ landOp }};transition:opacity .7s ease;pointer-events:{{ landPe }}">
    <div style="position:absolute;top:-14%;left:50%;margin-left:-160px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(242,178,62,.24) 0%,rgba(242,178,62,0) 70%);animation:glowPulse 6s ease-in-out infinite"></div>
    <img src="assets/logo-02.png" alt="Eternalgy" style="width:216px;position:relative">
    <div style="font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:#8F8A7E;position:relative">Choose language · 选择语言</div>
    <div style="display:flex;gap:16px;position:relative">
      <div onClick="{{ chooseZh }}" style="cursor:pointer;min-width:132px;text-align:center;background:rgba(255,255,255,.04);border:1px solid rgba(242,178,62,.5);border-radius:16px;padding:22px 26px;box-shadow:0 8px 30px rgba(242,178,62,.08)">
        <div style="font-family:'Noto Serif SC',serif;font-size:32px;font-weight:700;color:#F4F1EA;line-height:1">中文</div>
        <div style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#8F8A7E;margin-top:9px">Mandarin</div>
      </div>
      <div onClick="{{ chooseEn }}" style="cursor:pointer;min-width:132px;text-align:center;background:rgba(255,255,255,.04);border:1px solid rgba(242,178,62,.5);border-radius:16px;padding:22px 26px;box-shadow:0 8px 30px rgba(242,178,62,.08)">
        <div style="font-size:30px;font-weight:700;color:#F4F1EA;line-height:1">English</div>
        <div style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#8F8A7E;margin-top:9px">英文</div>
      </div>
    </div>
  </div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:390,&quot;height&quot;:844},&quot;autoAdvance&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:false,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Playback&quot;},&quot;captions&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:false,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Playback&quot;}}">
class Component extends DCLogic {
