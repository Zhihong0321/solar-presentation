    2: [[1.5, 's2gen'], [1.8, { c: ['gen', 0, 860, 2000] }], [4.5, 's2chip'], [5.5, 's2flow'], [6.0, 's2left'], [8.5, 's2right'], [13.5, 's2conv'], [14.0, { c: ['nb2', 0, 95, 2200] }], [16.5, 's2tag']],
