      s4eyebrow: 'Why Eternalgy · 01', s4warn: 'Before you compare quotes — one thing you deserve to know.', s4trickPre: 'The most common trick in this industry: ', s4trickEm: 'overclaimed savings.', rm50: 'RM 50/mo', x20: '× 20 years', s4lossLabel: "that never arrives, across your system's lifetime", s4lies: 'Small lies compound.', s4badge: "MALAYSIA'S FIRST SOLAR SIMULATOR", s4flashA: '860 kWh', s4flashMid: ' → 40% / 60% → ', s4flashB: 'RM 95', s4flashTail: ' — on your actual TNB tariff', s4notestPre: 'The numbers you saw just now? ', s4notestEm: "They're not estimates.",
      s5eyebrow: 'Why Eternalgy · 02', s5l1Pre: 'When we ', s5l1Em: "don't understand", s5l1Mid: ' a product…', s5l1Tail: 'we pick the cheapest.', s5l2Pre: 'When we ', s5l2Em: 'truly understand', s5l2Mid: ' it —', s5l2Tail: 'we avoid the cheapest.', s5qLine1: 'So… are you looking for', s5qLine2: 'the cheapest right now?', s5yearsLabel: 'This system will sit on your roof for', s5yearsUnit: ' YEARS', s5failLine1: 'Cheap components fail early.', s5failLine2: 'At best — a dead system.', s5failLine3: 'At worst…', s5fire: 'a fire, on your own home.', s5subLine1: 'A real bargain is honesty;', s5subLine2: "what's truly expensive is risk.",
      s6eyebrow: 'Why Eternalgy · 03', s6h2Line1: "We don't disappear", s6h2Line2: 'after installation.', s6teamPre: 'Our ', s6teamEm: 'in-house roof maintenance team', s6teamPost: ' responds to any roof issue — for the life of your system.', s6projLabel1: 'projects', s6projLabel2: 'in a single month', terraceTag: 'Terrace', bungalowTag: 'Bungalow', farmTag: 'Farm', industrialTag: 'Industrial', s6everyRoof: 'Every roof type in Malaysia.', s6badge1: 'Maybank Exclusive Partner', s6badge2: 'SAJ Sole Distributor of Malaysia', s6badge3: 'Golden Bull Award',
      s7eyebrow: 'Your package · the ask', s7lead: 'Panels, inverter, installation — and every warranty.', s7promo: 'PROMO', s7afterDiscount: 'after discount · all-in', s7yrsUnit: ' yrs', s7payPre: 'payback — everything after that is ', s7payEm: 'pure savings.', s7warrPanelLabel: 'Panel', s7warrPanelText: ' 12yr product · 30yr power', s7warrInvLabel: 'Inverter', s7warrInvText: ' 10yr', s7warrInstallLabel: 'Install', s7warrInstallText: ' 1yr roof-leak · 3yr workmanship · 3yr MSIG all-risk', s7cta: 'Book Your Free Roof Assessment'
    },
    zh: {
      tap: '轻触开始', presenting: '讲解中', next: '下一页',
      s0h1: '太阳能到底能为您的家\n带来什么', s0thesisPre: '…而这也取决于', s0thesisEm: '是谁为您安装。',
      s1eyebrow: '您的电费 · 前后对比', s1curLabel: '目前每月电费', perMo: '/月', s1withLabel: '安装太阳能后', s1tailPre: '每个月都省 — ', s1tailEm: '而且持续数十年。',
      s2eyebrow: '我们如何计算', kwhMo: 'kWh/月', s2genLabel: '您的太阳能板每月发电量', s2leftLabel: '直接供应您的家庭用电', s2rightLabel: '输出至电网换取电费回扣', s2newBillLabel: '您的新电费', s2chip: '☀ 每日约4小时日照高峰', s2tagPre: '由', s2tagEm: '马来西亚首个太阳能模拟系统', s2tagPost: '，根据您实际的TNB电费级距逐级计算。',
      s3eyebrow: '您的方案', kwpUnit: ' kWp', s3sizedLabel: '根据您的屋顶与用电量精准配置', s3panelName: '13 片 × 650W JinkoSolar\nN型 TOPCon 电池板', s3badge: '一线大厂 · 12年产品保固 / 30年功率保证', s3invName: 'SAJ 串式逆变器',
      s4eyebrow: '为什么选择 Eternalgy · 01', s4warn: '在您比较报价之前 — 有件事您应该知道。', s4trickPre: '这个行业最常见的手法就是：', s4trickEm: '夸大节省金额。', rm50: 'RM 50/月', x20: '× 20 年', s4lossLabel: '在系统的使用年限内，永远不会兑现', s4lies: '小小的谎言，累积成大数目。', s4badge: '马来西亚首创太阳能模拟系统', s4flashA: '860 度', s4flashMid: ' → 40% / 60% → ', s4flashB: 'RM 95', s4flashTail: ' — 根据您实际的TNB电费', s4notestPre: '您刚才看到的数字？', s4notestEm: '这不是估算，是精算。',
      s5eyebrow: '为什么选择 Eternalgy · 02', s5l1Pre: '当我们', s5l1Em: '不了解', s5l1Mid: '一个产品的时候…', s5l1Tail: '我们会选择最便宜的。', s5l2Pre: '当我们', s5l2Em: '真正了解', s5l2Mid: '一个产品的时候 —', s5l2Tail: '我们反而会避开最便宜的。', s5qLine1: '那么…此刻的您', s5qLine2: '是否正在寻找最便宜的方案？', s5yearsLabel: '这套系统将在您的屋顶上，运行', s5yearsUnit: ' 年', s5failLine1: '廉价元件，故障来得早。', s5failLine2: '运气好，系统直接报废。', s5failLine3: '运气不好…', s5fire: '是您家中的一场火灾。', s5subLine1: '这句话，也是 Eternalgy', s5subLine2: '对每一位客户的承诺。',
      s6eyebrow: '为什么选择 Eternalgy · 03', s6h2Line1: '安装完成后', s6h2Line2: '我们不会消失。', s6teamPre: '我们的', s6teamEm: '内部专属屋顶维修团队', s6teamPost: '，在系统使用期间随时处理任何屋顶问题。', s6projLabel1: '个项目', s6projLabel2: '单月完成', terraceTag: '排屋', bungalowTag: '独立式洋房', farmTag: '农场', industrialTag: '工业厂房', s6everyRoof: '马来西亚各类屋顶，我们都能安装。', s6badge1: 'Maybank 独家合作伙伴', s6badge2: 'SAJ 马来西亚独家代理', s6badge3: '金牛奖得主',
      s7eyebrow: '您的方案 · 报价', s7lead: '太阳能板、逆变器、安装工程 — 以及所有保固。', s7promo: '优惠', s7afterDiscount: '折扣后 · 全包价', s7yrsUnit: ' 年', s7payPre: '回本 — 之后的每一分钱都是', s7payEm: '纯粹的节省。', s7warrPanelLabel: '太阳能板', s7warrPanelText: ' 12年产品保固 · 30年功率保证', s7warrInvLabel: '逆变器', s7warrInvText: ' 10年保固', s7warrInstallLabel: '安装工程', s7warrInstallText: ' 1年屋顶防漏 · 3年施工保固 · 3年MSIG全险保障', s7cta: '预约免费屋顶评估'
    }
  };

  componentDidMount() {
    this.reduced = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    this.audioNames = ['s0', 's1', 's2', 's3', 's4a', 's4b', 's5a', 's5b', 's5c', 's6', 's7'];
    this.audioEls = {};
  }

  loadAudio(lang) {
    const suf = lang === 'zh' ? '_zh' : '';
    this.audioEls = {};
    this.audioNames.forEach(n => { const a = new Audio('audio/' + n + suf + '.wav'); a.preload = 'auto'; this.audioEls[n] = a; });
  }

  choose(lang) {
    if (this.state.lang) return;
    this.loadAudio(lang);
    this.setState({ lang }, () => this.begin());
  }
  componentWillUnmount() { this.stopAll(); }

  stopAll() {
    this.timers.forEach(t => clearTimeout(t)); this.timers = [];
    Object.values(this.rafs).forEach(r => cancelAnimationFrame(r)); this.rafs = {};
    if (this.audioEls) Object.values(this.audioEls).forEach(a => { a.onended = null; a.pause(); });
  }

  count(key, from, to, dur) {
    if (this.rafs[key]) cancelAnimationFrame(this.rafs[key]);
    const start = performance.now();
    const step = now => {
      const p = Math.min(1, (now - start) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      const v = from + (to - from) * e;
      this.setState(s => ({ counters: { ...s.counters, [key]: v } }));
      if (p < 1) this.rafs[key] = requestAnimationFrame(step); else delete this.rafs[key];
    };
    this.rafs[key] = requestAnimationFrame(step);
  }

  setBeat(name) { this.setState(s => ({ beats: { ...s.beats, [name]: true } })); }

  enterSlide(i, force) {
    if (i === this.state.active && !force) return;
    this.stopAll();
    const prefix = 's' + i;
    const beats = { ...this.state.beats };
    Object.keys(beats).forEach(k => { if (k.indexOf(prefix) === 0) delete beats[k]; });
    const counters = { ...this.state.counters, ...(this.RESET[i] || {}) };
    this.setState({ active: i, beats, counters, narrating: false }, () => {
      if (i === 0 && !this.state.begun) return;
      this.runSlide(i);
    });
  }

  slideDur(lang, i) {
    const seq = this.SEQ[i], d = this.CLIPDUR[lang];
    return seq.reduce((sum, name, idx) => sum + (d[name] || 0) + (idx < seq.length - 1 ? (this.GAP[name] || 0) / 1000 : 0), 0);
  }

  beatScale(i) {
    const lang = this.state.lang || 'en';
    if (lang === 'en') return 1;
    const enDur = this.slideDur('en', i);
    return enDur > 0 ? this.slideDur('zh', i) / enDur : 1;
  }

  runSlide(i) {
    const entries = this.BEATS[i] || [];
    if (this.reduced) {
      const beats = { ...this.state.beats };
      entries.forEach(([, x]) => { if (typeof x === 'string') beats[x] = true; });
      this.setState({ beats, counters: { ...this.state.counters, ...(this.FINAL[i] || {}) } });
    } else {
      const scale = this.beatScale(i);
      entries.forEach(([t, x]) => {
        this.timers.push(setTimeout(() => {
          if (typeof x === 'string') this.setBeat(x); else this.count(...x.c);
        }, t * scale * 1000));
      });
    }
    if (this.state.begun) this.playSeq(i, 0);
  }

  playSeq(i, idx) {
    const seq = this.SEQ[i];
    if (idx >= seq.length) {
      this.setState({ narrating: false });
      if (this.props.autoAdvance ?? false) this.timers.push(setTimeout(() => this.next(), 1400));
      return;
    }
    const a = this.audioEls && this.audioEls[seq[idx]];
    if (!a) { this.setState({ narrating: false }); return; }
    this.setState({ narrating: true });
    try { a.currentTime = 0; } catch (e) {}
    a.onended = () => {
      const g = this.GAP[seq[idx]] || 0;
      this.timers.push(setTimeout(() => this.playSeq(i, idx + 1), g));
    };
    a.play().catch(() => {});
  }

  next() {
    if (!this.scrollEl) return;
    const i = Math.min(7, this.state.active + 1);
    this.scrollEl.scrollTo({ top: i * this.scrollEl.clientHeight, behavior: 'smooth' });
  }

  begin() {
    if (this.state.begun) return;
    Object.entries(this.audioEls || {}).forEach(([n, a]) => {
      if (n === 's0') return;
      try {
        a.muted = true;
        const p = a.play();
        if (p) p.then(() => { a.pause(); a.currentTime = 0; a.muted = false; }).catch(() => { a.muted = false; });
      } catch (e) { a.muted = false; }
    });
    this.setState({ begun: true }, () => this.runSlide(0));
  }

  onScroll(e) {
    if (this.scrollPending) return;
    this.scrollPending = true;
    requestAnimationFrame(() => {
      this.scrollPending = false;
      const el = this.scrollEl; if (!el) return;
      const i = Math.max(0, Math.min(7, Math.round(el.scrollTop / el.clientHeight)));
      if (i !== this.state.active) this.enterSlide(i);
    });
  }

  renderVals() {
    const b = this.state.beats, cs = this.state.counters;
    const lang = this.state.lang || 'en';
    const t = this.T[lang];
    const HIDE = 'opacity:0;transform:translateY(26px)', SHOW = 'opacity:1;transform:translateY(0px)';
    const PHIDE = 'opacity:0;transform:scale(.55)', PSHOW = 'opacity:1;transform:scale(1)';
    const r = {};
    ['s0logo', 's0title', 's0thesis', 's1cur', 's1arrow', 's1new', 's1tail', 's2gen', 's2chip', 's2left', 's2right', 's2conv', 's2tag', 's3kwp', 's3panel', 's3inv', 's3formula', 's4warn', 's4trick', 's4lies', 's4flash', 's4notest', 's5years', 's5fail', 's5prov', 's5sub', 's6msg', 's6img', 's6stat', 's6badges', 's6photo', 's7lead', 's7price', 's7pay', 's7warr', 's7cta'].forEach(k => { r[k] = b[k] ? SHOW : HIDE; });
    ['s1badge', 's3badge', 's4rm50', 's4x12', 's4x20', 's4badge', 's6r1', 's6r2', 's6r3', 's6r4', 's6c1', 's6c2', 's6c3', 's6c4'].forEach(k => { r[k] = b[k] ? PSHOW : PHIDE; });
    r.s5l1 = (b.s5l1 && !b.s5qonly) ? SHOW : HIDE;
    r.s5l2 = (b.s5l2 && !b.s5qonly) ? SHOW : HIDE;
    r.s5q = b.s5qonly ? SHOW : HIDE;
    const c = {
      bill: Math.round(cs.bill), nb: Math.round(cs.nb), pct: Math.round(cs.pct),
      gen: Math.round(cs.gen), nb2: Math.round(cs.nb2), kwp: Number(cs.kwp).toFixed(2),
      loss: Math.round(cs.loss).toLocaleString('en-US'), proj: Math.round(cs.proj),
      price: Math.round(cs.price).toLocaleString('en-US')
    };
    const dots = [];
    for (let i = 0; i < 8; i++) {
      const on = i === this.state.active;
      dots.push({ s: 'width:6px;border-radius:99px;transition:all .4s ease;height:' + (on ? '22px' : '6px') + ';background:' + (on ? '#F2B23E' : 'rgba(255,255,255,.22)') });
    }
    return {
      r, c, dots, t,
      begin: () => this.begin(),
      onScroll: e => this.onScroll(e),
      setScroll: el => { this.scrollEl = el; },
      tapOp: this.state.begun ? 0 : 1,
      landOp: this.state.lang ? 0 : 1,
      landPe: this.state.lang ? 'none' : 'auto',
      chooseEn: () => this.choose('en'),
      chooseZh: () => this.choose('zh'),
      logoOp: this.state.active !== 0 ? 1 : 0,
      presentOp: (this.state.begun && this.state.narrating) ? 1 : 0,
      nextArrowOp: (this.state.begun && !this.state.narrating && this.state.active < 7) ? 1 : 0,
      flowOp: b.s2flow ? 1 : 0,
      qBlockOp: b.s5years ? 0 : 1,
      yearsOp: (b.s5years && !b.s5prov) ? 1 : 0,
      provOp: b.s5prov ? 1 : 0,
      fireOp: b.s5fire ? 1 : 0,
      dimOp: b.s5dim ? (b.s5prov ? 0.25 : 0.5) : 0,
      ctaAnim: b.s7cta ? 'animation:ctaPulse 2.2s ease-in-out infinite' : '',
      showCap: !!(this.props.captions ?? false),
      capText: (lang === 'zh' ? this.NARR_ZH : this.NARR_EN)[this.state.active]
    };
  }
}
</script>
</body>
</html>
