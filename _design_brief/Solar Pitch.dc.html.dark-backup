    6: [[0.8, 's6msg'], [1.4, 's6img'], [4.3, 's6stat'], [4.5, { c: ['proj', 0, 140, 1600] }], [7.8, 's6r1'], [8.5, 's6r2'], [9.2, 's6r3'], [9.9, 's6r4'], [12.5, 's6c1'], [13.4, 's6c2'], [14.3, 's6c3'], [15.2, 's6c4'], [17.0, 's6badges'], [18.5, 's6photo']],
    7: [[0.8, 's7lead'], [1.8, 's7price'], [2.2, { c: ['price', 26800, 24200, 2200] }], [6.5, 's7pay'], [9.0, 's7warr'], [13.5, 's7cta']]
  };
  NARR_EN = [
    "Hi — and thank you for your time. In the next two minutes, I'll show you exactly what solar can do for your home… and why it matters who installs it.",
    "Right now, your electricity bill averages three hundred and eighty ringgit a month. With solar… that drops to around ninety-five. That's a seventy-five percent saving — every single month, for decades to come.",
    "And this number is not a guess. Your panels will generate around eight hundred and sixty kilowatt-hours a month. About forty percent powers your home directly during the day — the rest is exported to the grid for credit, calculated against your actual TNB tariff, rate by rate.",
    "Here's the system that does it. Thirteen JinkoSolar panels — six hundred and fifty watts each, Tier-one, N-type — paired with an SAJ inverter. Eight-point-four-five kilowatts, sized precisely for your roof and your usage.",
    "The most common trick in this industry is overclaimed savings. Even a small exaggeration compounds to over twelve thousand ringgit that never arrives. That's why we built Malaysia's first solar simulator — your forecast is calculated on your actual TNB tariff structure.",
    "When we don't understand a product, we pick the cheapest. When we truly understand it — we avoid the cheapest. This system will sit on your roof for 15–20 years. A real bargain is honesty; what's truly expensive is risk.",
    "We don't disappear after installation. Our in-house roof maintenance team responds to any roof issue, for the life of your system. 140 projects in a single month. Every roof type in Malaysia. Certified by SEDA, CIDB, and MyHIJAU.",
    "Panels, inverter, installation, and every warranty — at twenty-four thousand two hundred ringgit after discount. Payback in around six years. Everything after that is pure savings. Shall we get your roof assessed?"
  ];
  NARR_ZH = [
    "您好，感谢您抽出时间。接下来的两分钟，我将为您展示太阳能到底能为您的家带来什么…以及，为什么选择安装的人很重要。",
    "目前，您每个月的电费大约是三百八十令吉。安装太阳能之后…这个数字会降到大约九十五令吉。相当于节省百分之七十五 — 而且每个月都是如此，持续数十年。",
    "而这个数字，并不是随口估算的。您的太阳能板每个月大约能发电八百六十度。其中大约百分之四十，在白天直接供应您的家庭用电 — 剩下的则输出到电网换取电费回扣，并根据您实际的TNB电费级距，逐级精算而成。",
    "这就是为您配置的系统。十三片JinkoSolar太阳能板 — 每片六百五十瓦，一线大厂，N型电池 — 搭配SAJ逆变器。总容量八点四五千瓦，根据您的屋顶与用电量精准配置。",
    "这个行业最常见的手法，就是夸大节省金额。哪怕只是一点点的夸大，累积起来，也会是超过一万二千令吉，永远不会兑现的差距。这就是为什么，我们打造了马来西亚首创的太阳能模拟系统 — 您所看到的预测，都是根据您实际的TNB电费结构精算而成。",
    "当我们不了解一个产品的时候，我们会选择最便宜的。当我们真正了解一个产品的时候 — 我们反而会避开最便宜的。这套系统，将在您的屋顶上运行十五到二十年。真正的划算，是诚信；真正的昂贵，是风险。",
    "安装完成后，我们不会消失。我们拥有内部专属的屋顶维修团队，在系统使用期间，随时为您处理任何屋顶问题。单月完成一百四十个项目，马来西亚各类屋顶，我们都能安装。并获得SEDA、CIDB与MyHIJAU认证。",
    "太阳能板、逆变器、安装工程，以及所有保固 — 折扣后价格为两万四千两百令吉。大约六年即可回本，之后的每一分钱，都是纯粹的节省。现在，为您预约一次免费的屋顶评估，好吗？"
  ];

  CLIPDUR = {
    en: { s0: 10.88, s1: 13.76, s2: 19.20, s3: 17.92, s4a: 18.40, s4b: 12.96, s5a: 17.12, s5b: 16.00, s5c: 9.12, s6: 22.56, s7: 18.72 },
    zh: { s0: 13.60, s1: 17.44, s2: 24.00, s3: 17.60, s4a: 14.08, s4b: 12.48, s5a: 17.44, s5b: 17.28, s5c: 6.24, s6: 20.96, s7: 19.36 }
